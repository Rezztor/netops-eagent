class Refused(Exception):
    """A file or a request this machine does not take. `text` is shown to the administrator as it is."""

    def __init__(self, code, text):
        super().__init__(text)
        self.code, self.text = code, text


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


# --- the manifest: plain functions ---------------------------------------------


def version_key(version):
    return tuple(int(part) for part in version.split("."))


def read_manifest(body):
    """The signed manifest as a dict, or Refused. Called only after the signature held."""
    try:
        m = json.loads(body.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        raise Refused("bad_manifest", "This file was not accepted: its description cannot be read.") from None
    bad = Refused("bad_manifest", "This file was not accepted: its description is not one this version understands.")
    if not isinstance(m, dict) or m.get("format") not in FORMATS:
        raise Refused(
            "format",
            "This update was made for a newer update tool than this machine has. Ask Rezztor for the package that comes first.",
        )
    if m.get("product") != PRODUCT:
        raise Refused("product", "This file is not an update for Rezztor EAgent.")
    for key in ("version", "base", "min_from"):
        if not isinstance(m.get(key), str) or not VERSION.fullmatch(m[key].removesuffix(UAT)):
            raise bad
    if m.get("restart") not in ("none", "application") or not isinstance(m.get("database_change"), bool):
        raise bad
    notes = m.get("notes")
    if not isinstance(notes, list) or len(notes) > 20 or not all(isinstance(n, str) and len(n) <= 400 for n in notes):
        raise bad
    payload = m.get("payload")
    if (
        not isinstance(payload, dict)
        or not isinstance(payload.get("size"), int)
        or not re.fullmatch(r"[0-9a-f]{64}", str(payload.get("sha256")))
    ):
        raise bad
    images = m.get("images")
    if not isinstance(images, dict) or not set(images) <= set(IMAGES):
        raise bad
    for name, spec in images.items():
        if not isinstance(spec, dict) or spec.get("mode") not in ("files", "image"):
            raise bad
        if spec["mode"] == "files" and name != "eagent":
            raise bad
        if not re.fullmatch(r"(app|images)/[a-z0-9][a-z0-9._-]*", str(spec.get("file"))):
            raise bad
    host = m.get("host")
    if not isinstance(host, list) or not all(isinstance(n, str) and (n in HOST_FILES or NEW_KEY.fullmatch(n)) for n in host):
        raise bad
    if m["base"] == m["version"] and any(images.get(name, {}).get("mode") != "image" for name in IMAGES):
        raise bad  # a new base release carries every image whole
    if m["restart"] == "none" and (host or m["database_change"] or {n: s["mode"] for n, s in images.items()} != {"eagent": "files"}):
        raise bad  # only the application's own files can change without a restart
    minutes = m.get("start_minutes", START_MINUTES)
    if not isinstance(minutes, int) or not 1 <= minutes <= 60:
        raise bad
    system = m.get("os")
    if system is not None:
        if not isinstance(system, dict):
            raise bad
        packages = system.get("packages")
        if (
            not re.fullmatch(r"\d{8}T\d{6}Z", str(system.get("snapshot")))
            or not isinstance(system.get("reboot"), bool)
            or not isinstance(packages, list)
            or not 0 < len(packages) <= 3000
        ):
            raise bad
        for item in packages:
            if not isinstance(item, dict) or not DEB_NAME.fullmatch(str(item.get("name"))) or not DEB_VERSION.fullmatch(str(item.get("to"))):
                raise bad
            if (item.get("from") is not None and not DEB_VERSION.fullmatch(str(item["from"]))) or not DEB_FILE.fullmatch(str(item.get("file"))):
                raise bad
        if len({item["file"] for item in packages}) != len(packages):
            raise bad
    if m["format"] == 3 and (system is not None or any(n in HOST_FILES and n not in FORMAT_3_HOST for n in host)):
        raise bad  # format 3 is the shape a tool from before ADR 0092 takes
    return m


def release_of(have):
    """The suffix of the running version ("" or -uat), or Refused when it is not a release version."""
    if not have:
        raise Refused("not_installed", "The product is not installed on this machine yet.")
    # A UAT machine's version ends in -uat (ADR 0085).
    suffix = UAT if str(have).endswith(UAT) else ""
    if not VERSION.fullmatch(str(have).removesuffix(suffix)):
        # .env says what runs, and not every stack runs a release: a lab build's version ends in -lab, a
        # hand-installed one may say `latest`. version_key would raise on it, and the tool would stop.
        raise Refused(
            "not_a_release",
            f"This machine runs {have}, which is not a release version, so no update file fits it. "
            "An update is made for one release; install that release first.",
        )
    return suffix


def fits(m, installed):
    """Refused when this machine cannot take the update: older, or made for another release."""
    have, base = installed.get("version"), installed.get("base")
    # The package's three versions must carry -uat exactly when the running one does: a release takes no UAT
    # package, and a UAT machine takes no release package.
    suffix = release_of(have)
    plain = {}
    for key in ("version", "base", "min_from"):
        value = m[key].removesuffix(suffix)
        if not m[key].endswith(suffix) or not VERSION.fullmatch(value):
            raise Refused(
                "other_kind",
                f"This update is {m['version']}, made for a {'release' if suffix else 'UAT test'} machine. "
                f"This machine runs {have}, a {'UAT test machine' if suffix else 'release'}, and takes no such file.",
            )
        plain[key] = value
    running = have.removesuffix(suffix)
    if version_key(plain["version"]) <= version_key(running):
        raise Refused(
            "older",
            f"This update is {m['version']}. You run {have}, which is "
            f"{'the same' if plain['version'] == running else 'newer'}. There is no way back to an older version.",
        )
    if version_key(running) < version_key(plain["min_from"]):
        raise Refused(
            "too_old",
            f"This update needs at least {m['min_from']}. You run {have}. Ask Rezztor for the package that comes first.",
        )
    if m["base"] != m["version"] and m["base"] != base:
        raise Refused(
            "other_release",
            f"This update needs release {m['base']}. You run {have} on release {base}. "
            "Ask Rezztor for the package for your release.",
        )


def live_plan(old, new):
    """(files to copy, files to remove) to turn the running tree `old` into `new`, both {path: sha256},
    when nothing but texts and screens differs. None when a restart is the only honest way."""
    copy = sorted(path for path in new if old.get(path) != new[path])
    remove = sorted(path for path in old if path not in new)
    live = all(any(path == prefix or (prefix.endswith("/") and path.startswith(prefix)) for prefix in LIVE) for path in copy + remove)
    return (copy, remove) if live and old and new else None


