def env_get(text, key):
    for line in text.splitlines():
        if line.startswith(key + "="):
            return line[len(key) + 1 :].strip().strip("'\"")
    return ""


def env_set(text, key, value):
    """One line changed or added; every other line as it was (.env holds the secrets)."""
    lines = text.splitlines()
    at = [i for i, line in enumerate(lines) if line.startswith(key + "=")]
    if at:
        lines[at[0]] = f"{key}={value}"
    else:
        lines.append(f"{key}={value}")
    return "\n".join(lines) + "\n"


def stack_env():
    """The stack's .env as it is, or Refused. It holds every secret of the installation, so nothing is
    ever written back that did not start from the whole file."""
    text = _read(STACK + "/.env")
    if not text or "REZZTOR_VERSION=" not in text:
        raise Refused("no_stack", "The product's settings file (.env) could not be read. Nothing was changed.")
    return text


