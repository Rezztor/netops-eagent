# Everything the ISO build fetches, pinned. Sourced by scripts/build_iso.sh.

# Debian's own installer image. The checksum is from Debian's SHA256SUMS for
# 13.7.0, read over HTTPS on 2026-10-05. When Debian makes a newer point
# release this file moves to https://cdimage.debian.org/cdimage/archive/13.7.0/.
# Moving to a newer point release means: change these three lines, delete
# os-packages.sha256, build, and commit the new os-packages.sha256.
DEBIAN_ISO=debian-13.7.0-amd64-netinst.iso
DEBIAN_ISO_URL=https://cdimage.debian.org/debian-cd/13.7.0/amd64/iso-cd/debian-13.7.0-amd64-netinst.iso
DEBIAN_ISO_SHA256=a7ef94ac2fb9a7fec454552abd629b7cc9d5155c886165a45649f5ce6167e355

# The throwaway container the build tools run in.
TOOLS_BASE=debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

# Docker's package signing key (https://download.docker.com/linux/debian/gpg).
DOCKER_KEY_FPR=9DC858229FC7DD38854AE2D88D81803C0EBFCD88

# Docker's packages by exact version. Debian's packages need no version here:
# the suite "trixie" (without -security and -updates) changes only at a point
# release, so it holds the same versions as the installer image above. Every
# file of both kinds is then checked against os-packages.sha256.
OS_PACKAGE_PINS="docker-ce=5:29.8.2-1~debian.13~trixie docker-ce-cli=5:29.8.2-1~debian.13~trixie containerd.io=2.3.6-1~debian.13~trixie docker-compose-plugin=5.6.0-1~debian.13~trixie"
