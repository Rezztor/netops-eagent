# Fast executor rebuild: layer the current executor code on an image that already has the pinned
# Ansible collections, so nothing is downloaded from Galaxy.
#
#   ./scripts/build_local.sh ansible-quick
#
# Needs a previously built rezztor/eagent-ansible image (the full executor/Dockerfile) tagged
# rezztor/eagent-ansible:collections-base. Use the full Dockerfile whenever the collection pins change.
FROM rezztor/eagent-ansible:collections-base
USER root
ARG CATALOGUE_COMMIT=""
ENV REZZTOR_ANSIBLE_CATALOGUE_COMMIT=${CATALOGUE_COMMIT}
WORKDIR /app
# The base is an earlier image and carries that image's code; none of it may
# stay beside what is copied in.
RUN rm -rf /app/executor /app/plugins
COPY executor/*.py /app/executor/
COPY plugins/_ea_ansible/__init__.py /app/plugins/_ea_ansible/__init__.py
COPY plugins/_ea_ansible/helpers/ /app/plugins/_ea_ansible/helpers/
COPY executor/templates/ /app/executor/templates/
COPY executor/playbooks/ /app/executor/playbooks/
COPY plugins/_ea_ansible/catalogue.yaml /app/plugins/_ea_ansible/catalogue.yaml
COPY plugins/_ea_ansible/playbooks/ /app/plugins/_ea_ansible/playbooks/
COPY executor/ea-ansible /usr/local/bin/ea-ansible
RUN chmod 0755 /usr/local/bin/ea-ansible \
    && python -c "import executor.app, executor.console, executor.cli; print('executor ok')" \
    && python -c "from plugins._ea_ansible.helpers import catalogue; print('catalogue', sorted(catalogue.load()))"
RUN mkdir -p /run/ansible-socket && chown 1000:1000 /run/ansible-socket && chmod 0750 /run/ansible-socket
USER ansible
